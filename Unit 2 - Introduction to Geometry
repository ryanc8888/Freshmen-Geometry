v.append(top,msg,g,r)}
function viewProg(){const v=$("#view");v.innerHTML="";const known=Object.values(S.cards).filter(x=>x=="k").length,qa=Object.keys(S.qs).length,qc=Object.entries(S.qs).filter(([a,b])=>D.qs[a][3]==b).length;
const bar=(t,n,m,x)=>`<div class="card"><b>${t}</b><div class="bar"><i data-w="${m?100*n/m:0}"></i></div>${x||n+" of "+m}</div>`;
v.innerHTML=bar("Flashcards known",known,D.cards.length)+bar("Practice questions answered",qa,D.qs.length)+bar("Practice questions correct",qc,D.qs.length)+
bar("Random question accuracy",S.rand.ok,S.rand.n,`${S.rand.ok} of ${S.rand.n} correct · best streak ${S.rand.best}`)+
`<div class="card"><b>Match game</b><div class="mu">${S.match.rounds} rounds finished · best time ${S.match.best?S.match.best.toFixed(1)+"s":"none yet"}</div></div>`;
