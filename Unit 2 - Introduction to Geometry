def g_reason():
    t, r = random.choice(RT)
    a, b, c = random.sample(range(1, 7), 3)
    opts = random.sample([x for x in REASONS if x != r], 3) + [r]
    random.shuffle(opts)
    return {"q": "What is the reason for this step?  " + t.format(a=a, b=b, c=c), "options": opts, "answer": opts.index(r), "why": f"The reason is the {r}.", "level": 3}


def g_quad():
    if random.random() < 0.5:
        r, s = random.choice([(1, 90), (2, 45), (3, 30), (5, 18), (6, 15), (9, 10)])
        tot, word = 90, "complementary"
    else:
        r, s = random.choice([(1, 180), (2, 90), (3, 60), (4, 45), (5, 36), (6, 30), (9, 20), (10, 18), (12, 15)])
        tot, word = 180, "supplementary"
    p = s - r
    return mk(f"Two {word} angles measure x² degrees and {p}x degrees. What is x? (Angle measures cannot be negative.)", r, [s, p, r + 1],
              f"x² + {p}x = {tot}, so x² + {p}x − {tot} = 0. That factors to (x − {r})(x + {s}) = 0. x = {r} or x = −{s}. A measure can't be negative, so x = {r}.", unit="", level=4, hi=999)


def g_system():
    if random.random() < 0.5:
        tot, word, d = 90, "complementary", random.choice(range(2, 42, 2))
    else:
        tot, word, d = 180, "supplementary", random.choice(range(10, 102, 2))
    big = (tot + d) // 2
    return mk(f"Two angles are {word}. The larger angle is {d}° more than the smaller. What is the larger angle?", big, [tot - big, d, big + 5],
              f"Let the small angle be y. y + (y + {d}) = {tot}, so y = {(tot - d) // 2}. The larger angle is {big}°.", level=4, hi=180)


