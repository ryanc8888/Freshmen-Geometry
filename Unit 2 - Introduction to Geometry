const TABS=[["cards","Flashcards"],["quiz","Practice"],["rand","Random"],["match","Match"],["prog","Progress"]];
let D,S={theme:null,cards:{},qs:{},rand:{n:0,ok:0,streak:0,best:0,lv:{}},match:{best:0,rounds:0}},tab="cards",saveT,tick;
const save=()=>{clearTimeout(saveT);saveT=setTimeout(()=>fetch("/api/state",{method:"POST",headers:{"Content-Type":"application/json"},body:JSON.stringify(S)}),250)};
const shuffle=a=>{for(let i=a.length-1;i>0;i--){const j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a};
const burst=()=>{for(let i=0;i<30;i++){const p=el("i","cf");const a=Math.random()*6.28,d=120+Math.random()*180;p.style.setProperty("--dx",Math.cos(a)*d+"px");p.style.setProperty("--dy",Math.sin(a)*d-60+"px");p.style.setProperty("--r",Math.random()*720+"deg");p.style.setProperty("--c",Object.values(COL)[i%7]);document.body.appendChild(p);setTimeout(()=>p.remove(),1200)}};
