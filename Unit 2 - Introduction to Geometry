k.innerHTML=`<div class="face"><div class="tag">${c[2]}</div><div class="big">${c[0]}</div><div class="mu">Tap to flip</div></div><div class="face back"><div class="tag">${c[2]}</div><div style="font-size:1.1rem">${c[1]}</div></div>`;
k.onclick=()=>k.classList.toggle("flip");sc.appendChild(k);v.appendChild(sc);
