function viewCards(){const v=$("#view");v.innerHTML="";const chips=el("div","row");
["All",...Object.keys(COL)].forEach(c=>{const b=el("button","chip"+(cf.cat==c?" on":""),c);b.style.setProperty("--c",COL[c]||"#5b6cff");b.onclick=()=>{cf.cat=c;cf.i=0;viewCards()};chips.appendChild(b)});v.appendChild(chips);
const lab=el("label","mu");lab.innerHTML=`<input type="checkbox" ${cf.only?"checked":""}> Hide cards I know`;lab.firstChild.onchange=e=>{cf.only=e.target.checked;cf.i=0;viewCards()};v.appendChild(lab);
const d=deck();if(!d.length){v.appendChild(el("div","card","Nothing here. Every card in this group is marked known."));return}
cf.i=((cf.i%d.length)+d.length)%d.length;const c=D.cards[d[cf.i]],st=S.cards[c[0]];
