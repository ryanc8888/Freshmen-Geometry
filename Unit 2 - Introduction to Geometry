$("#theme").onclick=()=>{applyTheme(S.theme=="dark"?"light":"dark");save()};
function go(t){tab=t;clearInterval(tick);$("#nav").innerHTML="";TABS.forEach(([k,n])=>{const b=el("button",k==t?"on":"",n);b.onclick=()=>go(k);$("#nav").appendChild(b)});const v=$("#view");v.classList.remove("in");v.innerHTML="";({cards:viewCards,quiz:viewQuiz,rand:viewRand,match:viewMatch,prog:viewProg})[t]();requestAnimationFrame(()=>requestAnimationFrame(()=>v.classList.add("in")))}
let cf={cat:"All",only:false,order:null,i:0};
