const r=el("div","row");
const add=(t,cl,f)=>{const b=el("button","btn "+cl,t);b.onclick=f;r.appendChild(b)};
add("← Previous","",()=>{cf.i--;viewCards()});
add("Flip","",()=>k.classList.toggle("flip"));
add("Study again","no",()=>{S.cards[c[0]]="r";save();cf.i++;viewCards()});
add("Got it","ok",()=>{S.cards[c[0]]="k";save();if(!cf.only)cf.i++;viewCards()});
add("Next →","",()=>{cf.i++;viewCards()});
add("Shuffle","pri",()=>{cf.order=shuffle(D.cards.map((x,i)=>i));cf.i=0;viewCards()});
v.appendChild(r)}
document.addEventListener("keydown",e=>{if(tab!=="cards"||!D)return;const k=$(".c3d");if(e.key=="ArrowRight"){cf.i++;viewCards()}else if(e.key=="ArrowLeft"){cf.i--;viewCards()}else if(e.key==" "&&k){e.preventDefault();k.classList.toggle("flip")}});
let qf={topic:"All",p:0};
function viewQuiz(){const v=$("#view");v.innerHTML="";const tops=["All",...new Set(D.qs.map(q=>q[0]))];
const chips=el("div","row");tops.forEach(t=>{const b=el("button","chip"+(qf.topic==t?" on":""),t);b.style.setProperty("--c",COL[t]||"#5b6cff");b.onclick=()=>{qf.topic=t;qf.p=0;viewQuiz()};chips.appendChild(b)});v.appendChild(chips);
const ids=D.qs.map((q,i)=>i).filter(i=>qf.topic=="All"||D.qs[i][0]==qf.topic);qf.p=((qf.p%ids.length)+ids.length)%ids.length;
const i=ids[qf.p],q=D.qs[i],done=Object.keys(S.qs).length,ok=Object.entries(S.qs).filter(([a,b])=>D.qs[a][3]==b).length;
v.appendChild(el("div","mu",`Question ${qf.p+1} of ${ids.length} · ${ok} correct of ${done} answered`));
const card=el("div","card");card.appendChild(el("div","big",q[1]));const box=el("div");const why=el("div");
const paint=()=>{box.innerHTML="";q[2].forEach((o,j)=>{const a=S.qs[i],b=el("button","opt"+(a!=null?(j==q[3]?" right":j==a?" wrong":""):""),o);b.disabled=a!=null;b.onclick=()=>{S.qs[i]=j;save();paint()};box.appendChild(b)});why.innerHTML=S.qs[i]!=null?`<div class="why">${S.qs[i]==q[3]?"Correct. ":"Not quite. "}${q[4]}</div>`:""};
paint();card.append(box,why);v.appendChild(card);
const r=el("div","row");const bk=el("button","btn","← Back");bk.onclick=()=>{qf.p--;viewQuiz()};const nx=el("button","btn pri","Next →");nx.onclick=()=>{qf.p++;viewQuiz()};
const rs=el("button","btn","Reset practice");rs.onclick=()=>{S.qs={};save();viewQuiz()};r.append(bk,nx,rs);v.appendChild(r)}
let rv=0;
function viewRand(){const v=$("#view");v.innerHTML="";const c=el("div","card");
c.innerHTML=`<div class="mu">Difficulty</div><div class="lvn" id="ln"></div><input class="sl" id="sl" type="range" min="0" max="4" step="0.01" value="${rv}"><div class="lv">${LV.map(x=>`<span>${x}</span>`).join("")}</div>`;
v.appendChild(c);const sl=$("#sl",c),ln=$("#ln",c);
const paint=()=>{const x=+sl.value;sl.style.setProperty("--p",x/4*100+"%");const L=Math.round(x);sl.style.setProperty("--lc",LC[L]);ln.textContent=LV[L]};
paint();sl.oninput=paint;
sl.onchange=()=>{const f=+sl.value,t=Math.round(f),t0=performance.now();const run=n=>{const k=Math.min(1,(n-t0)/220);sl.value=f+(t-f)*(1-Math.pow(1-k,3));paint();if(k<1)requestAnimationFrame(run);else{rv=t;nextQ()}};requestAnimationFrame(run)};
const st=el("div","stats");st.id="st";v.appendChild(st);const qb=el("div");qb.id="qb";v.appendChild(qb);rv=Math.round(rv);nextQ()}
function stats(){const s=S.rand,l=S.rand.lv[rv]||{n:0,ok:0};$("#st").innerHTML=`<div class="stat"><b>${s.streak}</b>streak</div><div class="stat"><b>${s.best}</b>best streak</div><div class="stat"><b>${s.n?Math.round(100*s.ok/s.n):0}%</b>overall</div><div class="stat"><b>${l.n?Math.round(100*l.ok/l.n):0}%</b>${LV[rv]}</div>`}
async function nextQ(){stats();const box=$("#qb");box.innerHTML='<div class="card mu">Making a new question...</div>';const lvl=rv;
const q=await fetch("/api/random?level="+lvl+"&t="+Date.now()).then(r=>r.json());if(tab!=="rand")return;
const card=el("div","card");card.style.animation="pop .4s";card.appendChild(el("div","big",q.q));const ob=el("div"),wy=el("div");let done=false;
q.options.forEach((o,j)=>{const b=el("button","opt",o);b.onclick=()=>{if(done)return;done=true;const L=S.rand.lv[lvl]||{n:0,ok:0};L.n++;S.rand.n++;
if(j==q.answer){S.rand.ok++;L.ok++;S.rand.streak++;S.rand.best=Math.max(S.rand.best,S.rand.streak);b.classList.add("right");if(S.rand.streak%5==0)burst()}else{S.rand.streak=0;b.classList.add("wrong");ob.children[q.answer].classList.add("right")}
S.rand.lv[lvl]=L;save();stats();[...ob.children].forEach(x=>x.disabled=true);wy.innerHTML=`<div class="why">${j==q.answer?"Correct! ":"Not quite. "}${q.why}</div>`;const n=el("button","btn pri","New question");n.style.marginTop="12px";n.onclick=nextQ;wy.appendChild(n)};ob.appendChild(b)});
card.append(ob,wy);box.innerHTML="";box.appendChild(card)}
function viewMatch(){const v=$("#view");v.innerHTML="";const ps=shuffle(D.pairs.slice()).slice(0,8);
const tiles=shuffle(ps.flatMap((p,k)=>[{k,kind:"t",x:p[0]},{k,kind:"d",x:p[1]}]));
let sel=null,got=0,moves=0,t0=0;
const top=el("div","stats");top.innerHTML=`<div class="stat"><b id="tm">0.0s</b>time</div><div class="stat"><b id="mv">0</b>moves</div><div class="stat"><b>${S.match.best?S.match.best.toFixed(1)+"s":"--"}</b>best time</div>`;
const msg=el("div","mu","Match each reason or theorem (purple) with its meaning (teal).");msg.style.margin="12px 0";
const g=el("div","grid");
tiles.forEach(t=>{const b=el("button","tile "+t.kind,t.x);t.b=b;b.onclick=()=>{
if(t.done||t===sel)return;if(!t0){t0=Date.now();tick=setInterval(()=>{$("#tm").textContent=((Date.now()-t0)/1000).toFixed(1)+"s"},100)}
if(!sel){sel=t;b.classList.add("sel");return}
if(sel.kind==t.kind){sel.b.classList.remove("sel");sel=t;b.classList.add("sel");return}
moves++;$("#mv").textContent=moves;
if(sel.k==t.k){[sel,t].forEach(z=>{z.done=true;z.b.classList.remove("sel");z.b.classList.add("done")});sel=null;got++;
if(got==8){clearInterval(tick);const s=(Date.now()-t0)/1000;S.match.rounds++;const nb=!S.match.best||s<S.match.best;if(nb)S.match.best=s;save();burst();msg.innerHTML=`Done in <b>${s.toFixed(1)}s</b> with ${moves} moves.${nb?" New best time!":""}`}}
else{const a=sel;sel=null;a.b.classList.remove("sel");[a,t].forEach(z=>z.b.classList.add("bad"));setTimeout(()=>[a,t].forEach(z=>z.b.classList.remove("bad")),450)}};g.appendChild(b)});
