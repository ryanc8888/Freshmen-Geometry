def expr(a, b):
    s = "x" if a == 1 else f"{a}x"
    if b > 0:
        return f"{s} + {b}"
    if b < 0:
        return f"{s} − {-b}"
    return s


def mk(q, correct, extras, why, unit="°", level=0, hi=360):
    pool = []
    for e in extras:
        if 0 < e <= hi and e != correct and e not in pool:
            pool.append(e)
    random.shuffle(pool)
    pool = pool[:3]
    steps = [1, 2, 3, 4, 5, 6, 8, 10, 12, 15, 20]
    random.shuffle(steps)
    for s in steps:
        for c in (correct + s, correct - s):
            if len(pool) < 3 and 0 < c <= hi and c != correct and c not in pool:
                pool.append(c)
    vals = pool + [correct]
    random.shuffle(vals)
    return {"q": q, "options": [f"{v}{unit}" for v in vals], "answer": vals.index(correct), "why": why, "level": level}


def pair180():
    while True:
        k, m = random.randint(1, 4), random.randint(1, 3)
        x, b = random.randint(5, 30), random.randint(0, 20)
        c = 180 - (k + m) * x - b
        if -40 <= c <= 40 and k * x + b > 0 and m * x + c > 0 and (k, b) != (m, c):
            return k, b, m, c, x


def equal_pair(cap=170):
    while True:
        a, c = random.randint(1, 6), random.randint(1, 6)
        x, b = random.randint(3, 15), random.randint(0, 15)
        d = (a - c) * x + b
        if a != c and 0 < a * x + b <= cap:
            return a, b, c, d, x


def g_comp():
    A = random.randint(10, 80)
    return mk(f"What is the complement of a {A}° angle?", 90 - A, [A, 180 - A, 90 + A], f"Complementary angles add to 90, so 90 − {A} = {90 - A}.", hi=180)


def g_supp():
    A = random.randint(20, 160)
    return mk(f"What is the supplement of a {A}° angle?", 180 - A, [A, abs(90 - A), 360 - A], f"Supplementary angles add to 180, so 180 − {A} = {180 - A}.", hi=180)


def g_vert():
    A = random.randint(25, 155)
    return mk(f"Two lines cross and one angle measures {A}°. What is the measure of its vertical angle?", A, [180 - A, 90, 360 - A], f"Vertical angles are congruent, so the answer is {A}°.", hi=180)


def g_segadd():
    a, b = random.randint(3, 20), random.randint(3, 20)
    return mk(f"B is between A and C. AB = {a} and BC = {b}. What is AC?", a + b, [abs(a - b), a * b], f"Segment Addition Postulate: {a} + {b} = {a + b}.", unit="", hi=999)


def g_linpair():
    k, b, m, c, x = pair180()
    return mk(f"∠1 and ∠2 form a linear pair. m∠1 = ({expr(k, b)})° and m∠2 = ({expr(m, c)})°. What is x?", x, [k * x + b, m * x + c, 180 // (k + m)],
              f"A linear pair is supplementary, so {expr(k + m, b + c)} = 180. Solving gives x = {x}.", unit="", level=1, hi=999)


def g_bisector():
    h = random.randint(15, 85)
    return mk(f"Ray BD bisects ∠ABC and m∠ABC = {2 * h}°. What is m∠ABD?", h, [2 * h, 90 - h, h + 10], f"A bisector splits the angle into two equal parts. {2 * h} ÷ 2 = {h}.", level=1, hi=180)


def g_segexpr():
    a, c, x = random.randint(1, 5), random.randint(1, 5), random.randint(2, 12)
    b, d = random.randint(0, 9), random.randint(0, 9)
    T = (a + c) * x + b + d
    return mk(f"B is between A and C. AB = {expr(a, b)}, BC = {expr(c, d)}, and AC = {T}. What is x?", x, [x + 1, x - 1, T // (a + c)],
              f"AB + BC = AC, so {expr(a + c, b + d)} = {T}. Solving gives x = {x}.", unit="", level=1, hi=999)


def g_perp():
    a, x = random.randint(2, 6), random.randint(4, 15)
    b = 90 - a * x
    return mk(f"Lines p and q are perpendicular. One angle they form measures ({expr(a, b)})°. What is x?", x, [x + 2, x - 2, 90 // a],
              f"Perpendicular lines form right angles, so {expr(a, b)} = 90. Solving gives x = {x}.", unit="", level=1, hi=999)


def g_midpoint():
    while True:
        a, c, x = random.randint(2, 7), random.randint(1, 6), random.randint(2, 12)
        b = random.randint(1, 10)
        if a != c:
            break
    d = (a - c) * x + b
    half = a * x + b
    return mk(f"M is the midpoint of XY. XM = {expr(a, b)} and MY = {expr(c, d)}. What is XY?", 2 * half, [half, x, 2 * half + 2 * x],
              f"A midpoint makes XM = MY, so {expr(a, b)} = {expr(c, d)} and x = {x}. Then XM = {half} and XY = 2({half}) = {2 * half}.", unit="", level=2, hi=999)


def g_suppk():
    if random.random() < 0.5:
        k = random.choice([2, 3, 4, 5, 8, 11])
        ang, tot, word = 180 // (k + 1), 180, "supplement"
    else:
        k = random.choice([2, 4, 5, 8, 9, 14])
        ang, tot, word = 90 // (k + 1), 90, "complement"
    times = "twice" if k == 2 else f"{k} times"
    return mk(f"The {word} of an angle is {times} the angle. What is the angle?", ang, [tot - ang, tot // k, 2 * ang],
              f"x + {k}x = {tot}, so {k + 1}x = {tot} and x = {ang}.", level=2, hi=180)


def g_altint():
    a, b, c, d, x = equal_pair()
    return mk(f"Two parallel lines are cut by a transversal. Alternate interior angles measure ({expr(a, b)})° and ({expr(c, d)})°. What is x?", x, [x + 2, x - 2, x + 5],
              f"Alternate interior angles are congruent, so {expr(a, b)} = {expr(c, d)}. Solving gives x = {x}.", unit="", level=2, hi=999)


def g_sameside():
    k, b, m, c, x = pair180()
    return mk(f"Two parallel lines are cut by a transversal. Same-side interior angles measure ({expr(k, b)})° and ({expr(m, c)})°. What is the measure of the first angle?", k * x + b,
              [m * x + c, x, 180 - (k * x + b) + 10], f"Same-side interior angles are supplementary, so {expr(k + m, b + c)} = 180 and x = {x}. The first angle is {k * x + b}°.", level=2, hi=180)


def g_vertexpr():
    a, b, c, d, x = equal_pair()
    return mk(f"Vertical angles measure ({expr(a, b)})° and ({expr(c, d)})°. What is the measure of the first angle?", a * x + b, [x, c * x + d + 10, 180 - (a * x + b)],
              f"Vertical angles are congruent, so {expr(a, b)} = {expr(c, d)} and x = {x}. The angle is {a * x + b}°.", level=3, hi=180)


def g_bisectexpr():
    a, b, c, d, x = equal_pair(85)
    h = a * x + b
    return mk(f"Ray BD bisects ∠ABC. m∠ABD = ({expr(a, b)})° and m∠DBC = ({expr(c, d)})°. What is m∠ABC?", 2 * h, [h, x, 2 * h + 10],
              f"A bisector makes the two angles equal, so {expr(a, b)} = {expr(c, d)} and x = {x}. Each part is {h}°, so ∠ABC = {2 * h}°.", level=3, hi=180)


def g_angadd():
    while True:
        a, c, x = random.randint(1, 5), random.randint(1, 5), random.randint(3, 15)
        b, d = random.randint(0, 15), random.randint(0, 15)
        T = (a + c) * x + b + d
        if T <= 175:
            break
    return mk(f"P is inside ∠ABC. m∠ABP = ({expr(a, b)})°, m∠PBC = ({expr(c, d)})°, and m∠ABC = {T}°. What is m∠PBC?", c * x + d, [a * x + b, x, T - 10],
              f"Angle Addition Postulate: {expr(a + c, b + d)} = {T}, so x = {x}. Then m∠PBC = {c * x + d}°.", level=3, hi=180)


