class Handler(BaseHTTPRequestHandler):
    def reply(self, body, kind="application/json", code=200):
        data = body.encode("utf-8") if isinstance(body, str) else body
        self.send_response(code)
        self.send_header("Content-Type", kind + "; charset=utf-8")
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):
        url = urlparse(self.path)
        if url.path == "/":
            self.reply(PAGE, "text/html")
        elif url.path == "/api/data":
            self.reply(json.dumps({"cards": CARDS, "qs": QS, "pairs": PAIRS}))
        elif url.path == "/api/state":
            try:
                self.reply(SAVE.read_text(encoding="utf-8"))
            except (OSError, ValueError):
                self.reply("{}")
        elif url.path == "/api/random":
            try:
                level = int(parse_qs(url.query).get("level", ["0"])[0])
            except ValueError:
                level = 0
            self.reply(json.dumps(random_question(level)))
        else:
            self.reply("Not found", "text/plain", 404)

    def do_POST(self):
        if self.path != "/api/state":
            self.reply("Not found", "text/plain", 404)
            return
        size = int(self.headers.get("Content-Length", 0))
        raw = self.rfile.read(size)
        try:
            json.loads(raw)
            SAVE.write_bytes(raw)
            self.reply('{"ok":true}')
        except ValueError:
            self.reply('{"ok":false}', code=400)

    def log_message(self, *args):
        pass


def main():
    server = None
    for port in range(8000, 8020):
        try:
            server = ThreadingHTTPServer(("127.0.0.1", port), Handler)
            break
        except OSError:
            continue
    if server is None:
        raise SystemExit("No free port found")
    url = f"http://127.0.0.1:{server.server_address[1]}"
    print(f"Geometry Study Lab running at {url}")
    print("Press Ctrl+C to stop.")
    threading.Timer(0.6, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        server.shutdown()


if __name__ == "__main__":
    main()
