.tag{font-size:.72rem;letter-spacing:.08em;text-transform:uppercase;color:var(--c);font-weight:700}
.big{font-size:1.35rem;font-weight:700;margin:8px 0}
@keyframes pop{from{opacity:0;transform:scale(.94) translateY(10px)}to{opacity:1;transform:none}}
.opt{display:block;width:100%;text-align:left;margin:8px 0;padding:12px 14px;border-radius:12px;border:1px solid var(--bd);background:var(--card);color:var(--tx);font:inherit;cursor:pointer;transition:transform .15s,background .25s,border-color .25s}
.opt:hover:not(:disabled){transform:translateX(4px);border-color:var(--ac)}
.opt.right{background:color-mix(in srgb,var(--ok) 22%,var(--card));border-color:var(--ok)}
.opt.wrong{background:color-mix(in srgb,var(--no) 22%,var(--card));border-color:var(--no);animation:shake .35s}
@keyframes shake{25%{transform:translateX(-6px)}75%{transform:translateX(6px)}}
.why{margin-top:10px;padding:10px 12px;border-radius:12px;background:color-mix(in srgb,var(--ac) 12%,transparent);animation:pop .3s}
.bar{height:12px;background:var(--bd);border-radius:8px;overflow:hidden;margin:6px 0 14px}
.bar i{display:block;height:100%;width:0;background:linear-gradient(90deg,#5b6cff,#ec4899);border-radius:8px;transition:width .8s cubic-bezier(.2,.8,.2,1)}
.sl{width:100%;-webkit-appearance:none;appearance:none;height:14px;border-radius:10px;outline:none;background:linear-gradient(90deg,var(--lc) var(--p),var(--bd) var(--p));cursor:pointer}
.sl::-webkit-slider-thumb{-webkit-appearance:none;width:30px;height:30px;border-radius:50%;background:var(--card);border:4px solid var(--lc);box-shadow:var(--sh);transition:transform .15s}
.sl::-webkit-slider-thumb:hover{transform:scale(1.15)}
.sl::-moz-range-thumb{width:22px;height:22px;border-radius:50%;background:var(--card);border:4px solid var(--lc)}
.lv{display:flex;justify-content:space-between;font-size:.8rem;color:var(--mu);margin-top:6px}
.lvn{font-size:1.6rem;font-weight:800;color:var(--lc);transition:color .3s}
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:10px}
.tile{min-height:78px;padding:10px;border-radius:14px;border:2px solid var(--bd);background:var(--card);color:var(--tx);font:inherit;font-size:.88rem;cursor:pointer;transition:transform .2s,background .3s,border-color .3s,opacity .5s}
.tile.t{border-bottom:5px solid #a855f7}
.tile.d{border-bottom:5px solid #14b8a6}
.tile:hover:not(.done){transform:translateY(-3px)}
.tile.sel{border-color:var(--ac);transform:scale(1.06);background:color-mix(in srgb,var(--ac) 18%,var(--card))}
.tile.bad{border-color:var(--no);animation:shake .4s}
.tile.done{border-color:var(--ok);background:color-mix(in srgb,var(--ok) 20%,var(--card));opacity:.55;transform:scale(.95);cursor:default}
.stats{display:flex;gap:10px;flex-wrap:wrap}
.stat{flex:1;min-width:90px;text-align:center;padding:10px;border-radius:14px;background:color-mix(in srgb,var(--ac) 10%,var(--card));border:1px solid var(--bd)}
.stat b{display:block;font-size:1.4rem}
.cf{position:fixed;left:50%;top:40%;width:10px;height:10px;border-radius:2px;background:var(--c);pointer-events:none;z-index:9;animation:fly 1.1s ease-out forwards}
@keyframes fly{to{transform:translate(var(--dx),var(--dy)) rotate(var(--r));opacity:0}}
</style></head><body>
<header><h1>Geometry Study Lab</h1><button id="theme" aria-label="Switch theme"></button></header>
<main><nav id="nav"></nav><div id="view" class="view"></div></main>
<script>
const $=(s,e=document)=>e.querySelector(s);
